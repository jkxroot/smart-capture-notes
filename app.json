{
  "expo": {
    "name": "Smart Capture & Notes",
    "slug": "smart-capture-notes",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "smartcapture",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "This app needs camera access to capture photos for your notes.",
        "NSPhotoLibraryUsageDescription": "This app needs photo library access to attach photos to your notes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2563EB",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you attach pictures to your notes.",
          "cameraPermission": "The app accesses your camera to let you take photos for your notes."
        }
      ]
    ]
  }
}
