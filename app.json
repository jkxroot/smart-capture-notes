{
  "expo": {
    "name": "Smart Capture",
    "slug": "smart-capture",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "smartcapture",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "This app needs camera access to capture photos for your notes.",
        "NSPhotoLibraryUsageDescription": "This app needs photo library access to attach photos to your notes."
      }
    },
    "android": {
      "package": "com.smartcapture.notes",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#1E6560",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBFBFA"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you attach pictures to your notes.",
          "cameraPermission": "The app accesses your camera to let you take photos for your notes."
        }
      ],
      "expo-sqlite",
      [
        "expo-build-properties",
        {
          "android": {
            "architectures": ["arm64-v8a"]
          }
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "9bfdce3a-2a3e-43ef-a26e-8f655e63ddf6"
      }
    },
    "owner": "jkxroot1"
  }
}
